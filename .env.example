# Copy to .env.local for local development (never commit .env.local).
# Values below are the defaults printed by `npx supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<anon key from `npx supabase status`>

# Optional: path prefix the app is served from. Leave empty for "/".
# GitHub Actions sets this to "/<repo-name>/" for GitHub Pages automatically.
# BASE_PATH=/acoe-book-my-desk/
